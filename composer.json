{
    "name": "kipchak/driver-rabbitmq",
    "type": "middleware",
    "description": "A RabbitMQ driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "CouchDB",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\RabbitMQ\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "mamluk/tavshan": "^1",
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-logger": "^1"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.rabbitmq.php",
            "initialise": "\\Kipchak\\Driver\\RabbitMQ\\RabbitMQ::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-rabbitmq"
        }
    }
}
